#!/bin/sh /etc/rc.common
# ex4-svc (EX4 persistent system v1): SERVICE MODE. S96 = md1 read-write behind the recovery wall, the tuned knobs,
# ext4 rw at /mnt/md1, NFSv3 (with the v9.9 nfsd prep), smartd. K01 = the clean stop FIRST on any shutdown / reboot.
# /usr/sbin/ex4-svc says how.
START=96
STOP=01
boot() { ( /usr/sbin/ex4-svc start ) </dev/null >/dev/null 2>&1 & }
start() { /usr/sbin/ex4-svc start; }
stop() { /usr/sbin/ex4-svc stop --for-reboot; }
